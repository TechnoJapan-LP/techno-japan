    <item>
      <title>MUTEK.JP 2025 | 現地レポート WWWとO-EASTで体感した音と光の二日間</title>
      <link>https://techno-japan.media/articles/post-20251120.html</link>
      <guid isPermaLink="true">https://techno-japan.media/articles/post-20251120.html</guid>
      <pubDate>Fri, 09 Jan 2026 00:00:00 +0900</pubDate>
      <category>REPORT</category>
      <description></description>
